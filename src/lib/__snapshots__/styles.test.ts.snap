exports[`createStyleString 1`] = `
"* {
  border-width: 0;
  border-style: solid;
  --mock-variable-padding-bottom: initial;
  --mock-variable-border-bottom-width: initial;
  --mock-variable-border-bottom-color: initial;
  --mock-variable-margin-top: initial;
  --mock-variable-margin-right: initial;
  --mock-variable-margin-bottom: initial;
  --mock-variable-margin-left: initial;
  break-inside: var(--mock-variable-break-inside, unset);
  break-after: var(--mock-variable-break-after, unset);
  text-align: var(--mock-variable-text-align, unset);
  line-height: var(--mock-variable-line-height, unset);
  font-weight: var(--mock-variable-font-weight, unset);
  font-style: var(--mock-variable-font-style, unset);
  font-size: var(--mock-variable-font-size, 16px);
  font-family: var(--mock-variable-font-family, unset);
  color: var(--mock-variable-color, unset);
  text-transform: var(--mock-variable-text-transform, unset);
  text-decoration: var(--mock-variable-text-decoration, unset);
  text-indent: var(--mock-variable-text-indent, unset);
  padding-bottom: var(--mock-variable-padding-bottom, unset);
  border-bottom-width: var(--mock-variable-border-bottom-width, 0);
  border-bottom-color: var(--mock-variable-border-bottom-color, unset);
  white-space: var(--mock-variable-white-space, unset);
}
:where(b, strong) {
  font-weight: bold;
}
:where(em, i) {
  font-style: italic;
}
:where(u) {
  text-decoration: underline;
}
:where(s) {
  text-decoration: line-through;
}
:where(sup) {
  vertical-align: super;
}
:where(sub) {
  vertical-align: sub;
}
:where(p, h1, h2, h3, h4, h5, h6, li, pre, blockquote) {
  margin-top: var(--mock-variable-margin-top, 0);
  margin-right: var(--mock-variable-margin-right, 0);
  margin-bottom: var(--mock-variable-margin-bottom, 0);
  margin-left: var(--mock-variable-margin-left, 0);
  display: flow-root;
}
:where(li) {
  display: list-item;
}
:where(h1) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 32px;
  --mock-variable-margin-top: 21.44px;
  --mock-variable-margin-bottom: 21.44px;
}
:where(h2) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 24px;
  --mock-variable-margin-top: 19.92px;
  --mock-variable-margin-bottom: 19.92px;
}
:where(h3) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 18.72px;
  --mock-variable-margin-top: 18.72px;
  --mock-variable-margin-bottom: 18.72px;
}
:where(h4) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 16px;
  --mock-variable-margin-top: 21.28px;
  --mock-variable-margin-bottom: 21.28px;
}
:where(h5) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 13.28px;
  --mock-variable-margin-top: 22.18px;
  --mock-variable-margin-bottom: 22.18px;
}
:where(h6) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 10.72px;
  --mock-variable-margin-top: 24.98px;
  --mock-variable-margin-bottom: 24.98px;
}
:where(blockquote) {
  --mock-variable-margin-top: 16px;
  --mock-variable-margin-right: 40px;
  --mock-variable-margin-bottom: 16px;
  --mock-variable-margin-left: 40px;
}
:where(pre) {
  --mock-variable-font-family: monospace;
  --mock-variable-margin-top: 16px;
  --mock-variable-margin-bottom: 16px;
  --mock-variable-white-space: pre;
}
:where(code) {
  --mock-variable-font-family: monospace;
}
:where(.mock-class-name-heading-1), :where(h1) {
  --mock-variable-break-inside: avoid;
  --mock-variable-break-after: avoid;
  --mock-variable-font-weight: bold;
  --mock-variable-font-style: italic;
  --mock-variable-font-size: 32px;
  --mock-variable-font-family: Merriweather;
  --mock-variable-color: #ff00ff;
}
:where(.mock-class-name-hyperlink), :where(a[href]) {
  --mock-variable-color: #ff00ff;
}
:where(.mock-class-name-mock-paragraph-variant) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 20px;
  --mock-variable-font-family: Merriweather;
  --mock-variable-color: var(--mock-color, #00dddd);
  --mock-variable-padding-bottom: 4px;
  --mock-variable-border-bottom-width: 4px;
  --mock-variable-border-bottom-color: #ffff00;
}
:where(.mock-class-name-mock-text-variant) {
  --mock-variable-font-weight: bold;
  --mock-variable-font-size: 20px;
  --mock-variable-font-family: Merriweather;
  --mock-variable-color: var(--mock-color, #00dddd);
}
:where(.mock-class-name-mock-content-variant) {
  --mock-variable-line-height: 24px;
  --mock-variable-text-indent: 16px;
  --mock-variable-margin-bottom: 16px;
}"

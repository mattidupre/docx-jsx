{
  "type": "module",
  "name": "matti-docs",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "files": [
    "dist/",
    "src/",
    "bundler/",
    "vite.config.*",
    "tsconfig.json"
  ],
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "types": "./dist/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@optimize-lodash/rollup-plugin": "^4.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@storybook/react": "^7.5.3",
    "@storybook/react-vite": "^7.5.3",
    "@types/hast": "^3.0.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.8.10",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~18.2.34",
    "@types/react-dom": "~18.2.14",
    "@types/react-reconciler": "^0.28.6",
    "@types/uuid": "^9.0.6",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "0.34.6",
    "clean-publish": "^4.2.0",
    "concurrently": "^8.2.2",
    "docx-preview": "^0.4.0",
    "dotenv-cli": "^7.3.0",
    "esbuild": "^0.19.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.12.0",
    "jest-extended": "^4.0.2",
    "jszip": "^3.10.1",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "^6.3.289",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-esbuild": "^6.1.0",
    "rollup-plugin-node-externals": "^6.1.2",
    "storybook": "^7.5.3",
    "type-fest": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.0.10",
    "vite-node": "^1.6.0",
    "vitest": "^0.34.6",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@types/react": "18.x",
    "@types/react-dom": "18.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-reconciler": "^0.29.0"
  },
  "peerDependenciesMeta": {
    "react-reconciler": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "colorjs.io": "0.4.5",
    "docx": "^8.5.0",
    "es-dirname": "^0.1.0",
    "hast-util-from-html": "^2.0.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-dom": "^4.0.0",
    "hast-util-to-html": "^9.0.0",
    "lodash": "^4.18.1",
    "pagedjs": "^0.4.3",
    "puppeteer-core": "24.8",
    "uuid": "^9.0.1"
  },
  "scripts": {
    "clean": "rm -rf dist/*",
    "build": "pnpm clean && pnpm build:all",
    "dev": "pnpm clean && nodemon --exec pnpm run build:all",
    "build:all": "pnpm run \"/^build:(src|types)$/\" && pnpm link:push",
    "build:src": "vite build",
    "build:types": "tsc --declaration --emitdeclarationonly --preservewatchoutput",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "vitest run src/visual",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 vitest run src/visual",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src",
    "link:push": "rm -rf ./publish && clean-publish --without-publish --temp-dir publish && yalc push publish && rm -rf ./publish",
    "storybook": "dotenv -- bash -c 'storybook dev --no-open --port \"${STORYBOOK_PORT:-3000}\"'"
  },
  "nodemonConfig": {
    "ext": "ts,js,tsx,jsx,json,css",
    "watch": [
      "src/**",
      "package.json",
      "esbuild.js"
    ],
    "ignore": [
      "**/test/**",
      "**/docs/**"
    ],
    "delay": 1000
  }
}
